<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (Dark) -->
    <style name="Theme.ArchivistAI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorPrimaryVariant">@color/brand_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_300</item>
        <item name="colorSecondaryVariant">@color/brand_500</item>
        <item name="colorOnSecondary">@color/dark_text_primary</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="colorSurfaceVariant">@color/dark_bg_tertiary</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_secondary</item>
        <item name="outline">@color/dark_border</item>
        <item name="primaryContainer">@color/brand_600</item>
        <item name="onPrimaryContainer">@color/white</item>
        <item name="secondaryContainer">@color/brand_300</item>
        <item name="onSecondaryContainer">@color/dark_text_primary</item>
        <item name="surfaceContainer">@color/dark_surface_elevated</item>
        <item name="surfaceContainerHigh">@color/dark_bg_tertiary</item>
        <item name="surfaceContainerHighest">@color/dark_surface</item>

        <!-- Edge-to-edge -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">?attr/colorPrimaryVariant</item>

        <!-- Theme overlay for dynamic colors -->
        <item name="themeOverlay">@style/ThemeOverlay.ArchivistAI.Dark</item>
    </style>

    <!-- Light theme variant -->
    <style name="Theme.ArchivistAI.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorPrimaryVariant">@color/brand_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_300</item>
        <item name="colorSecondaryVariant">@color/brand_500</item>
        <item name="colorOnSecondary">@color/light_text_primary</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="colorSurfaceVariant">@color/light_bg_tertiary</item>
        <item name="colorOnSurfaceVariant">@color/light_text_secondary</item>
        <item name="outline">@color/light_border</item>
        <item name="primaryContainer">@color/brand_100</item>
        <item name="onPrimaryContainer">@color/light_text_primary</item>
        <item name="secondaryContainer">@color/brand_100</item>
        <item name="onSecondaryContainer">@color/light_text_primary</item>
        <item name="surfaceContainer">@color/light_surface_elevated</item>
        <item name="surfaceContainerHigh">@color/light_bg_tertiary</item>
        <item name="surfaceContainerHighest">@color/light_surface</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <!-- Amber (coffee) theme variant -->
    <style name="Theme.ArchivistAI.Amber" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/amber_text_tertiary</item>
        <item name="colorPrimaryVariant">@color/amber_bg_secondary</item>
        <item name="colorOnPrimary">@color/amber_bg_primary</item>
        <item name="colorSecondary">@color/brand_300</item>
        <item name="colorSecondaryVariant">@color/brand_500</item>
        <item name="colorOnSecondary">@color/amber_text_primary</item>
        <item name="colorSurface">@color/amber_surface</item>
        <item name="colorOnSurface">@color/amber_text_primary</item>
        <item name="colorSurfaceVariant">@color/amber_bg_tertiary</item>
        <item name="colorOnSurfaceVariant">@color/amber_text_secondary</item>
        <item name="outline">@color/amber_border</item>
        <item name="primaryContainer">@color/amber_text_tertiary</item>
        <item name="onPrimaryContainer">@color/amber_bg_primary</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">?attr/colorPrimary</item>
    </style>

    <!-- Theme Overlay - Dark -->
    <style name="ThemeOverlay.ArchivistAI.Dark" parent="ThemeOverlay.Material3.DataSource">
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorOnPrimary">@color/dark_text_primary</item>
        <item name="colorSecondary">@color/brand_300</item>
        <item name="colorOnSecondary">@color/dark_text_primary</item>
    </style>

    <!-- NoActionBar theme (for the main activity) -->
    <style name="Theme.ArchivistAI.NoActionBar" parent="Theme.ArchivistAI"/>
</resources>